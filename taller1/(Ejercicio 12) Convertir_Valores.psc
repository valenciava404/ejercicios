Algoritmo Convertir_Valores
	Definir v1 Como real
	Escribir "Digita un numero para convertirlo a kilómetros, hectómetros, decámetros, decímetros, centímetros y milímetros:"
	leer v1
	kilómetros=(v1/1000)
	Hectómetros=(v1/100)
	Decámetros=(v1/10)
	Decímetros=(v1*10)
	Centímetros=(v1*100)
	Milímetros=(v1*1000)
	Escribir "Aqui tienes las conversiones:"
	Escribir "Kilometros ", kilómetros
	Escribir "Hectómetros ", Hectómetros
	Escribir "Decámetros ", Decámetros
	Escribir "Decímetros ", Decímetros
	Escribir "Centímetros ", Centímetros
	Escribir "Milímetros ", Milímetros
	FinAlgoritmo