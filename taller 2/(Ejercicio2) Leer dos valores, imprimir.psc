Algoritmo mayor_menor_numero
	definir num1, num2 como entero
	escribir "Dijita un numero para saber cual es el menor y mayor."
	leer num1
	escribir "Dijita tu segundo numero."
	leer num2
	
	si num1>num2 Entonces
			escribir "el valor " num1 " es mayor y ", num2 " es el valor menor"
		sino 
			escribir "el valor " num2 " es mayor y ", num1 " es el valor menor "
		FinSi
	FinAlgoritmo
